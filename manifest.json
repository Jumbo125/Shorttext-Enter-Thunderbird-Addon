{
  "manifest_version": 3,
  "name": "ShortText Enter",
  "version": "1.0.0",
  "description": "Ersetzt selbst definierte Kurztexte beim Drücken der Enter-Taste durch gespeicherte Volltexte.",
  "browser_specific_settings": {
    "gecko": {
      "id": "shorttext-enter@local.addon",
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "compose",
    "scripting"
  ]
}
